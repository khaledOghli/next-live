{
  "name": "next-live-monorepo",
  "private": true,
  "description": "Development monorepo for next-live: live TSX/JSX evaluation for React, SSR-safe and tuned for the Next.js App Router.",
  "license": "MIT",
  "author": "Khaled Oghli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khaledOghli/next-live.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w next-live",
    "dev": "npm run dev -w playground",
    "dev:lib": "npm run dev -w next-live",
    "lint": "npm run lint -w playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
