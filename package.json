{
  "name": "next-live-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w next-live",
    "dev": "npm run dev -w playground",
    "dev:lib": "npm run dev -w next-live",
    "lint": "npm run lint -w playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
