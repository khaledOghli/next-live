{
  "name": "next-live",
  "version": "1.0.0",
  "description": "Live TSX/JSX evaluation for React. Real ESM imports, a module registry instead of a global scope, and zero hydration mismatches. Works anywhere React runs, SSR-safe and tuned for the Next.js App Router.",
  "keywords": [
    "react",
    "next",
    "nextjs",
    "app-router",
    "live",
    "react-live",
    "playground",
    "sucrase",
    "jsx",
    "tsx",
    "editor",
    "eval",
    "ssr",
    "vite",
    "live-code",
    "code-editor",
    "react-19"
  ],
  "license": "MIT",
  "author": "Khaled Oghli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khaledOghli/next-live.git",
    "directory": "packages/next-live"
  },
  "homepage": "https://next-live-playground.vercel.app",
  "bugs": {
    "url": "https://github.com/khaledOghli/next-live/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "import": "./dist/prettier.js",
      "require": "./dist/prettier.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/add-use-client.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/add-use-client.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --exclude '**/*.test.tsx'",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:package": "npm run build && publint"
  },
  "dependencies": {
    "sucrase": "^3.35.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "prism-react-renderer": ">=2",
    "prettier": ">=3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.46.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.51.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.12",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "peerDependenciesMeta": {
    "prism-react-renderer": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  }
}
