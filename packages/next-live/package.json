{
  "name": "next-live",
  "version": "0.1.0",
  "description": "Live TSX/JSX evaluation for React \u2014 real ESM imports, a module registry instead of a global scope, and zero hydration mismatches. Works anywhere React runs, SSR-safe and tuned for the Next.js App Router.",
  "keywords": [
    "react",
    "next",
    "nextjs",
    "app-router",
    "live",
    "react-live",
    "playground",
    "sucrase",
    "jsx",
    "tsx",
    "editor",
    "eval",
    "ssr",
    "vite",
    "live-code",
    "code-editor",
    "react-19"
  ],
  "license": "MIT",
  "author": "Khaled Oghli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khaledOghli/next-live.git",
    "directory": "packages/next-live"
  },
  "homepage": "https://next-live-playground.vercel.app",
  "bugs": {
    "url": "https://github.com/khaledOghli/next-live/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/add-use-client.mjs",
    "dev": "tsup --watch --onSuccess \"node scripts/add-use-client.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --exclude '**/*.test.tsx'",
    "test:watch": "vitest"
  },
  "dependencies": {
    "sucrase": "^3.35.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "prism-react-renderer": ">=2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "prism-react-renderer": "^2.4.1"
  },
  "engines": {
    "node": ">=20.9"
  },
  "peerDependenciesMeta": {
    "prism-react-renderer": {
      "optional": true
    }
  }
}
